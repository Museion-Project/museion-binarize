visual-greek-0003","note_id":null,"paragraph_role":"continuation","reading_order":9,"source":"human","structure_status":"human_verified","text":"κακόν, ἀγαθόν. ἀνάγκη οὖν τὴν ἡδονὴν ἀγαθόν τι εἶναι. ὡς γὰρ Σπεύσιππος","transcription_status":"human_verified","typography_status":"human_verified"},{"bbox":[153,645,1342,680],"canonical_reference":null,"column_id":"main","content_class":"main_text","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"language":"grc","leaf_id":"single","line_id":"warren-osap36-pdf018-human-visual-greek-0004","note_id":null,"paragraph_role":"continuation","reading_order":10,"source":"human","structure_status":"human_verified","text":"ἔλυεν, οὐ συμβαίνει ἡ λύσις, ὥσπερ τὸ μεῖζον τῷ ἐλάττονι καὶ τῷ ἴσῳ ἐναντίον·","transcription_status":"human_verified","typography_status":"human_verified"},{"bbox":[154,687,1345,726],"canonical_reference":null,"column_id":"main","content_class":"main_text","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[{"bbox":null,"end_char":50,"semantic_role":"citation","span_id":"warren-osap36-pdf018-native-0007-visual-span-000","start_char":48,"styles":["italic"],"target_id":null,"text":"NE"},{"bbox":null,"end_char":63,"semantic_role":"canonical_reference","span_id":"warren-osap36-pdf018-native-0007-visual-span-001","start_char":62,"styles":["superscript"],"target_id":null,"text":"b"}],"language":"mixed","leaf_id":"single","line_id":"warren-osap36-pdf018-native-0007","note_id":null,"paragraph_role":"continuation","reading_order":11,"source":"human","structure_status":"human_verified","text":"οὐ γὰρ ἂν φαίη ὅπερ κακόν τι εἶναι τὴν ἡδονήν. (NE 7. 13, 1153b1–7 = F80a","transcription_status":"human_verified","typography_status":"human_verified"},{"bbox":[153,737,670,770],"canonical_reference":null,"column_id":"main","content_class":"main_text","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"language":"eng","leaf_id":"single","line_id":"warren-osap