ed","hierarchy_level":null,"inline_spans":[],"language":"eng","leaf_id":"single","line_id":"menn-metaphysics-pdf337-native-0002","note_id":null,"paragraph_role":"continuation","reading_order":2,"source":"human","structure_status":"human_verified","text":"later\" (at 93a21-33, which does nothing of the kind--it merely says that to know that thunder","transcription_status":"human_verified","typography_status":"human_verified"},{"bbox":[300,468,2216,523],"canonical_reference":null,"column_id":"main","content_class":"main_text","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"language":"eng","leaf_id":"single","line_id":"menn-metaphysics-pdf337-native-0003","note_id":null,"paragraph_role":"continuation","reading_order":3,"source":"human","structure_status":"human_verified","text":"exists we must know the nominal definition that is [a] noise in the clouds, which we presuppose","transcription_status":"human_verified","typography_status":"human_verified"},{"bbox":[300,525,2175,580],"canonical_reference":null,"column_id":"main","content_class":"main_text","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"language":"eng","leaf_id":"single","line_id":"menn-metaphysics-pdf337-native-0004","note_id":null,"paragraph_role":"continuation","reading_order":4,"source":"human","structure_status":"human_verified","text":"in seeking the real definition which gives the cause of its existence; the Owen quotes are LSD","transcription_status":"human_verified","typography_status":"human_verified"},{"bbox":[300,581,2202,642],"canonical_reference":null,"column_id":"main","content_class":"main_text","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"language":"eng","leaf_id":"single","line_id":"menn-metaphysics-pdf337-native-0005","note_id":null,"paragraph_role":"continuation","reading_order":5,"source":"human","structure_status":"human_verified","text":"p.270). Perhaps what moved Owen to all this was the view that an analysis of \"F exists\" as \"∃x","transcription_status":"human_verified","typography_status":"human_verified"},{"bbox":[300,644,2220,699],"canonical_reference":null,"column_id":"main","content_class":"main_text","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"language":"eng","leaf_id":"single","line_id":"menn-metaphysics-pdf337-native-0006","note_id":null,"paragraph_role":"continuation","reading_order":6,"source":"human","structure_status":"human_verified","text":"Fx\" would be unable to preserve the equivocity of being across the categories. But for Aristotle,","transcription_status":"human_verified","typography_status":"human_verified"},{"bbox":[300,702,2196,757],"canonical_reference":null,"column_id":"main","content_class":"main_text","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"language":"eng","leaf_id":"single","line_id":"menn-metaphysics-pdf337-native-0007","note_id":null,"paragraph_role":"continuation","reading_order":7,"source":"human","structure_status":"human_verified","text":"as we have seen, predicative being is equivocal across the categories (e.g. between \"Socrates is","transcription_status":"human_verified","typography_status":"human_verified"},{"bbox":[300,759,2220,814],"canonical_reference":null,"column_id":"main","content_class":"main_text","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"language":"eng","leaf_id":"single","line_id":"menn-metaphysics-pdf337-native-0008","note_id":null,"paragraph_role":"continuation","reading_order":8,"source":"human","structure_status":"human_verified","text":"white\" and \"Socrates is walking\"), and so if \"Fx\" and \"Gx\" assert different senses of predicative","transcription_status":"human_verified","typography_status":"human_verified"},{"bbox":[300,815,2264,876],"canonical_reference":null,"column_id":"main","content_class":"main_text","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"langua