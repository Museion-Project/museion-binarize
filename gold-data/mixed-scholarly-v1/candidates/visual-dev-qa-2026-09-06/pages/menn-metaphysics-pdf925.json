tus":"human_verified","typography_status":"candidate_unverified"},{"bbox":[300,2191,1882,2233],"canonical_reference":null,"column_id":"notes","content_class":"footnote","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"language":"eng","leaf_id":"single","line_id":"menn-metaphysics-pdf925-native-0034","note_id":"menn-metaphysics-pdf925-note-31","paragraph_role":"continuation","reading_order":34,"source":"human_draft","structure_status":"candidate_unverified","text":"and at least partly right, but what he says about Aristotle's conclusions must be totally rejected","transcription_status":"human_verified","typography_status":"candidate_unverified"},{"bbox":[300,2231,2244,2281],"canonical_reference":null,"column_id":"notes","content_class":"footnote","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[{"bbox":null,"end_char":2,"semantic_role":"footnote_marker","span_id":"menn-metaphysics-pdf925-native-0035-visual-qa-marker-00","start_char":0,"styles":["superscript"],"target_id":"menn-metaphysics-pdf925-note-32","text":"32"}],"language":"mixed","leaf_id":"single","line_id":"menn-metaphysics-pdf925-native-0035","note_id":"menn-metaphysics-pdf925-note-32","paragraph_role":"start","reading_order":35,"source":"human_draft","structure_status":"candidate_unverified","text":"32 Brunschwig rightly notes (FC p.279 n23, citing Elders) that σεμνόν echoes the passage of the Sophist cited above,","transcription_status":"human_verified","typography_status":"candidate_unverified"},{"bbox":[300,2286,2173,2328],"canonical_reference":null,"column_id":"notes","content_class":"footnote","geometry_status":"human_verified","hierarchy_level":null,"inline_spans":[],"language":"mixed","leaf_id":"single","line_id":"menn-metaphysics-pdf925-native-0036","note_id":"menn-metaphysics-pdf925-note-32","paragraph_role":"continuation","reading_order":36,"source":"human_draft","structure_status":"candidate_unverified","text":"asking whether \"complete being 