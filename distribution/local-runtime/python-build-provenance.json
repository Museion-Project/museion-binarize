{
  "python_version": "3.11.16",
  "target": "aarch64-apple-darwin",
  "deployment_target": "11.0",
  "sdk": "15.0",
  "licenses": [
    "Python-2.0",
    "CNRI-Python"
  ],
  "extensions": {
    "_bz2": {
      "licenses": [
        "bzip2-1.0.6"
      ],
      "license_paths": [
        "licenses/LICENSE.bzip2.txt"
      ],
      "links": [
        {
          "name": "bz2",
          "path_static": "build/lib/libbz2.a"
        }
      ]
    },
    "_ctypes": {
      "licenses": [
        "MIT"
      ],
      "license_paths": [
        "licenses/LICENSE.libffi.txt"
      ],
      "links": [
        {
          "name": "dl",
          "system": true
        },
        {
          "name": "ffi",
          "path_static": "build/lib/libffi.a"
        }
      ]
    },
    "_curses": {
      "licenses": [
        "X11"
      ],
      "license_paths": [
        "licenses/LICENSE.ncurses.txt"
      ],
      "links": [
        {
          "name": "ncurses",
          "system": true
        }
      ]
    },
    "_curses_panel": {
      "licenses": [
        "X11"
      ],
      "license_paths": [
        "licenses/LICENSE.ncurses.txt"
      ],
      "links": [
        {
          "name": "ncurses",
          "system": true
        },
        {
          "name": "panel",
          "system": true
        }
      ]
    },
    "_decimal": {
      "licenses": [
        "BSD-2-Clause"
      ],
      "license_paths": [
        "licenses/LICENSE.mpdecimal.txt"
      ],
      "links": [
        {
          "name": "mpdec",
          "path_static": "build/lib/libmpdec.a"
        }
      ]
    },
    "_elementtree": {
      "licenses": [
        "MIT"
      ],
      "license_paths": [
        "licenses/LICENSE.expat.txt"
      ],
      "links": [
        {
          "name": "expat",
          "path_static": "build/lib/libexpat.a"
        }
      ]
    },
    "_hashlib": {
      "licenses": [
        "Apache-2.0",
        "OpenSSL"
      ],
      "license_paths": [
        "licenses/LICENSE.openssl-1.1.txt",
        "licenses/LICENSE.openssl-3.txt"
      ],
      "links": [
        {
          "name": "crypto",
          "path_static": "build/lib/libcrypto.a"
        }
      ]
    },
    "_lzma": {
      "licenses": [
        "0BSD"
      ],
      "license_paths": [
        "licenses/LICENSE.liblzma.txt"
      ],
      "links": [
        {
          "name": "lzma",
          "path_static": "build/lib/liblzma.a"
        }
      ]
    },
    "_ssl": {
      "licenses": [
        "Apache-2.0",
        "OpenSSL"
      ],
      "license_paths": [
        "licenses/LICENSE.openssl-1.1.txt",
        "licenses/LICENSE.openssl-3.txt"
      ],
      "links": [
        {
          "name": "crypto",
          "path_static": "build/lib/libcrypto.a"
        },
        {
          "name": "ssl",
          "path_static": "build/lib/libssl.a"
        }
      ]
    },
    "_tkinter": {
      "licenses": [
        "TCL"
      ],
      "license_paths": [
        "licenses/LICENSE.tcl.txt"
      ],
      "links": [
        {
          "name": "tcl9.0",
          "system": true
        },
        {
          "name": "tcl9tk9.0",
          "system": true
        }
      ]
    },
    "_uuid": {
      "licenses": [
        "BSD-3-Clause"
      ],
      "license_paths": [
        "licenses/LICENSE.libuuid.txt"
      ],
      "links": [
        {
          "name": "uuid",
          "path_static": "build/lib/libuuid.a"
        }
      ]
    },
    "pyexpat": {
      "licenses": [
        "MIT"
      ],
      "license_paths": [
        "licenses/LICENSE.expat.txt"
      ],
      "links": [
        {
          "name": "expat",
          "path_static": "build/lib/libexpat.a"
        }
      ]
    },
    "readline": {
      "licenses": [
        "BSD-3-Clause",
        "X11"
      ],
      "license_paths": [
        "licenses/LICENSE.libedit.txt",
        "licenses/LICENSE.ncurses.txt"
      ],
      "links": [
        {
          "name": "edit",
          "system": true
        },
        {
          "name": "ncurses",
          "system": true
        }
      ]
    },
    "zlib": {
      "licenses": [
        "Zlib"
      ],
      "license_paths": [
        "licenses/LICENSE.zlib-ng.txt",
        "licenses/LICENSE.zlib.txt"
      ],
      "links": [
        {
          "name": "z",
          "system": true
        }
      ]
    }
  },
  "system_only_license_note": "The upstream metadata lists zlib-ng, but this macOS build links zlib from the operating system and ships no zlib-ng library."
}
