# ---------------------------------------------------------------------------
# Rust / Cargo
# ---------------------------------------------------------------------------
/target/
crates/*/target/
apps/desktop/src-tauri/target/
# Application crates commit their lockfile; library crates do not need one
# tracked separately here since the workspace root Cargo.lock covers them.

# ---------------------------------------------------------------------------
# Node.js / pnpm / Vite
# ---------------------------------------------------------------------------
node_modules/
apps/desktop/node_modules/
apps/desktop/dist/
apps/desktop/dist-ssr/
.pnpm-store/
*.local
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Tauri
# ---------------------------------------------------------------------------
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
# PDFium binaries are supplied through a separate controlled build/fetch
# process and must never be committed directly to the repository. The
# committed manifest and license texts under third_party/pdfium/ ARE
# tracked; only the binaries themselves are ignored.
**/vendor/pdfium/**
/target/pdfium/
/target/distribution/
apps/desktop/src-tauri/resources/pdfium/
*.dylib
*.dll
*.so

# Mac App Store entitlements are rendered from entitlements.mas.plist.template
# (see scripts/distribution/render_mas_entitlements.py) with the Team ID
# filled in from an environment variable — the rendered file never gets
# committed, only the placeholder template does.
apps/desktop/src-tauri/entitlements.mas.plist
# A real Mac App Store provisioning profile, once the owner has one, is a
# local build input — never committed.
apps/desktop/src-tauri/embedded.provisionprofile

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------------------------------------------------------------------------
# Linux
# ---------------------------------------------------------------------------
*~
.directory
.Trash-*

# ---------------------------------------------------------------------------
# Python (scripts/distribution/)
# ---------------------------------------------------------------------------
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ---------------------------------------------------------------------------
# Test, benchmark, and temporary output
# ---------------------------------------------------------------------------
/test-output/
/benchmark-output/
*.tmp.pdf
*.bench.json
*.criterion/

# ---------------------------------------------------------------------------
# Release packages
# ---------------------------------------------------------------------------
/dist/
/release/
*.dmg
*.msi
*.AppImage
*.deb
*.rpm

# ---------------------------------------------------------------------------
# Local AI coding tool state (not project configuration)
# ---------------------------------------------------------------------------
/.claude/

# ---------------------------------------------------------------------------
# Environment files and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.toml

# ---------------------------------------------------------------------------
# Explicitly NOT ignored (documented for clarity; do not add these below)
# ---------------------------------------------------------------------------
# !Cargo.lock
# !test-data/**
# !docs/**
# !.github/**
