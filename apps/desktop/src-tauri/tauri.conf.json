{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M PDF Processor",
  "version": "0.1.0-rc.3",
  "identifier": "me.mpdf.processor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "M PDF Processor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../scripts/bookmarks/local/*.py": "bookmarks/",
      "../../../scripts/bookmarks/local/vision_fast.swift": "bookmarks/vision_fast.swift",
      "../../../scripts/bookmarks/hierarchy_foundation_models/hierarchy.py": "hierarchy_foundation_models/hierarchy.py",
      "../../../scripts/bookmarks/hierarchy_models/manager.py": "hierarchy_models/manager.py",
      "../../../scripts/bookmarks/hierarchy_models/desktop_bridge.py": "hierarchy_models/desktop_bridge.py"
    }
  }
}
