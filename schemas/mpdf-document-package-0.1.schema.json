{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mpdf:document-package:0.1",
  "title": "Machine-readable Document Package 0.1",
  "description": "Schemas for each JSON record in an MDP directory. The manifest shape is the root schema; x-mpdf-files maps sibling files to their record schemas.",
  "type": "object",
  "required": ["schema", "schema_version", "document_id", "source_id", "page_count", "asset_count", "tool"],
  "properties": {
    "schema": { "const": "mpdf-document-package" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "document_id": { "type": "string", "pattern": "^doc-[0-9a-f]{64}$" },
    "source_id": { "type": "string", "pattern": "^source-[0-9a-f]{64}$" },
    "page_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "asset_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "tool": { "$ref": "#/$defs/tool" }
  },
  "additionalProperties": false,
  "x-mpdf-files": {
    "source.json": { "$ref": "#/$defs/source" },
    "pages/pNNNNNN.json": { "$ref": "#/$defs/page" },
    "assets.json": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/asset" } },
    "provenance.json": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/provenance" } },
    "validation.json": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "hex256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tool": { "type": "object", "required": ["name", "version"], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } },
    "source": { "type": "object", "required": ["source_id", "kind", "content_sha256", "byte_len", "page_count", "external_reference", "packaged_path"], "additionalProperties": false, "properties": { "source_id": { "type": "string", "pattern": "^source-[0-9a-f]{64}$" }, "kind": { "const": "pdf" }, "content_sha256": { "$ref": "#/$defs/hex256" }, "byte_len": { "type": "integer", "minimum": 0 }, "page_count": { "type": "integer", "minimum": 1 }, "external_reference": { "type": ["string", "null"] }, "packaged_path": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^source/[^\\\\]+$" }] } } },
    "space": { "type": "object", "required": ["id", "unit", "width", "height", "origin", "pixels_per_inch"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "unit": { "enum": ["pixels", "pdf_points"] }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "origin": { "enum": ["top_left", "bottom_left"] }, "pixels_per_inch": { "type": ["integer", "null"], "minimum": 1 } } },
    "transform": { "type": "object", "required": ["from_space", "to_space", "a", "b", "c", "d", "e", "f"], "additionalProperties": false, "properties": { "from_space": { "type": "string", "minLength": 1 }, "to_space": { "type": "string", "minLength": 1 }, "a": { "type": "number" }, "b": { "type": "number" }, "c": { "type": "number" }, "d": { "type": "number" }, "e": { "type": "number" }, "f": { "type": "number" } } },
    "rect": { "type": "object", "required": ["space_id", "x", "y", "width", "height"], "additionalProperties": false, "properties": { "space_id": { "type": "string", "minLength": 1 }, "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 }, "width": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 } } },
    "page": { "type": "object", "required": ["page_id", "physical_index", "order", "rotation_degrees", "master_space", "source_space", "transforms", "printed_page_label", "existing_outline_evidence", "typography_evidence", "region_evidence", "asset_ids"], "additionalProperties": false, "properties": { "page_id": { "type": "string", "pattern": "^page-[0-9a-f]{64}$" }, "physical_index": { "type": "integer", "minimum": 0 }, "order": { "type": "integer", "minimum": 0 }, "rotation_degrees": { "enum": [0, 90, 180, 270] }, "master_space": { "$ref": "#/$defs/space" }, "source_space": { "$ref": "#/$defs/space" }, "transforms": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/transform" } }, "printed_page_label": { "anyOf": [{ "$ref": "#/$defs/printed_label" }, { "type": "null" }] }, "existing_outline_evidence": { "type": "array", "items": { "$ref": "#/$defs/outline" } }, "typography_evidence": { "type": "array", "items": { "$ref": "#/$defs/typography" } }, "region_evidence": { "type": "array", "items": { "$ref": "#/$defs/region" } }, "asset_ids": { "type": "array", "items": { "type": "string", "pattern": "^asset-[0-9a-f]{64}$" } } } },
    "printed_label": { "type": "object", "required": ["label", "source"], "additionalProperties": false, "properties": { "label": { "type": "string" }, "source": { "enum": ["observed", "inferred"] } } },
    "outline": { "type": "object", "required": ["title", "level", "target_page_id", "source"], "additionalProperties": false, "properties": { "title": { "type": "string" }, "level": { "type": "integer", "minimum": 0 }, "target_page_id": { "type": ["string", "null"], "pattern": "^page-[0-9a-f]{64}$" }, "source": { "type": "string" } } },
    "typography": { "type": "object", "required": ["role", "bounds", "font_size_points"], "additionalProperties": false, "properties": { "role": { "type": "string" }, "bounds": { "$ref": "#/$defs/rect" }, "font_size_points": { "type": ["number", "null"], "minimum": 0 } } },
    "region": { "type": "object", "required": ["kind", "bounds"], "additionalProperties": false, "properties": { "kind": { "type": "string" }, "bounds": { "$ref": "#/$defs/rect" } } },
    "asset": { "type": "object", "required": ["asset_id", "kind", "path", "mime_type", "byte_len", "content_sha256", "page_id"], "additionalProperties": false, "properties": { "asset_id": { "type": "string", "pattern": "^asset-[0-9a-f]{64}$" }, "kind": { "enum": ["original", "master", "thumbnail", "bilevel"] }, "path": { "type": "string", "pattern": "^assets/[^\\\\]+$" }, "mime_type": { "type": "string", "minLength": 1 }, "byte_len": { "type": "integer", "minimum": 0 }, "content_sha256": { "$ref": "#/$defs/hex256" }, "page_id": { "type": ["string", "null"], "pattern": "^page-[0-9a-f]{64}$" } } },
    "provenance": { "type": "object", "required": ["step_id", "operation", "inputs", "outputs", "parameters", "software", "software_version", "execution"], "additionalProperties": false, "properties": { "step_id": { "type": "string", "minLength": 1 }, "operation": { "type": "string", "minLength": 1 }, "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "parameters": { "type": "object", "additionalProperties": { "type": "string" } }, "software": { "type": "string", "minLength": 1 }, "software_version": { "type": "string", "minLength": 1 }, "execution": { "const": "local" } } },
    "validation": { "type": "object", "required": ["schema", "schema_version", "valid", "checked_pages", "checked_assets", "errors"], "additionalProperties": false, "properties": { "schema": { "const": "mpdf-document-package" }, "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }, "valid": { "const": true }, "checked_pages": { "type": "integer", "minimum": 0 }, "checked_assets": { "type": "integer", "minimum": 0 }, "errors": { "type": "array", "items": { "type": "object", "required": ["code", "message"], "additionalProperties": false, "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } } }
  }
}
