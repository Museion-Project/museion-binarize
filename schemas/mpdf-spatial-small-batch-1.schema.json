{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mpdf-spatial-small-batch/1",
  "description": "Structural schema; executable validator reconstructs and compares every payload against independently checked inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model",
    "geometry_sha256",
    "input_manifest_sha256",
    "full_payload_sha256",
    "max_supports",
    "unit_boundary_policy",
    "automatic_retries",
    "batches"
  ],
  "properties": {
    "schema": {
      "const": "mpdf-spatial-small-batch/1"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "geometry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "full_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "max_supports": {
      "const": 4
    },
    "unit_boundary_policy": {
      "const": "preserve_or_reject_oversize"
    },
    "automatic_retries": {
      "const": 0
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "support_ids",
          "payload_sha256",
          "payload"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "support_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  }
}
