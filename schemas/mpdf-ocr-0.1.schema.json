{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpdf.example/schemas/mpdf-ocr-0.1.schema.json",
  "title": "MPDF OCR extension 0.1",
  "type": "object",
  "required": ["page_index", "route", "width", "height", "blocks", "revisions", "provider_provenance", "provider_raw_artifact"],
  "properties": {
    "page_index": {"type": "integer", "minimum": 0},
    "route": {
      "oneOf": [
        {"type": "string", "const": "native_text"},
        {"type": "object", "required": ["ocr"], "properties": {"ocr": {"type": "object", "required": ["reason"], "properties": {"reason": {"enum": ["missing_text", "too_little_text", "garbled_text"]}}, "additionalProperties": false}}, "additionalProperties": false}
      ]
    },
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "blocks": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/block"}},
    "revisions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/revision"}},
    "provider_provenance": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/provider_provenance"}]},
    "provider_raw_artifact": {"type": ["string", "null"], "maxLength": 1048576}
  },
  "$defs": {
    "box": {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0}}, "additionalProperties": false},
    "word": {"type": "object", "required": ["text", "normalized_text", "bbox", "confidence", "reading_order"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 16384}, "normalized_text": {"type": "string", "maxLength": 16384}, "bbox": {"$ref": "#/$defs/box"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "reading_order": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "line": {"type": "object", "required": ["bbox", "confidence", "reading_order", "words"], "properties": {"bbox": {"$ref": "#/$defs/box"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "reading_order": {"type": "integer", "minimum": 0}, "words": {"type": "array", "maxItems": 65536, "items": {"$ref": "#/$defs/word"}}}, "additionalProperties": false},
    "block": {"type": "object", "required": ["bbox", "confidence", "reading_order", "lines"], "properties": {"bbox": {"$ref": "#/$defs/box"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "reading_order": {"type": "integer", "minimum": 0}, "lines": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/line"}}}, "additionalProperties": false},
    "provider_provenance": {"type": "object", "required": ["engine", "model", "version", "parameters", "input_asset_sha256", "execution_location"], "properties": {"engine": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "parameters": {"type": "object", "additionalProperties": {"type": "string"}}, "input_asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "execution_location": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "revision": {"type": "object", "required": ["revision_id", "kind", "text"], "properties": {"revision_id": {"type": "string", "minLength": 1, "maxLength": 256}, "kind": {"enum": ["human", "ai_suggested"]}, "text": {"type": "string", "maxLength": 4194304}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
