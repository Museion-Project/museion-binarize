{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpdf.example/schema/bookmarks/0.2",
  "title": "Evidence-backed MPDF bookmarks 0.2 (automatic table-of-contents compilation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "source_digest",
    "package_digest",
    "derived_digest",
    "generator",
    "candidates",
    "generation_digest",
    "rule_config_digest",
    "rule_version",
    "generation_mode"
  ],
  "properties": {
    "schema": {
      "const": "mpdf-bookmarks"
    },
    "schema_version": {
      "const": "0.2"
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "package_digest": {
      "$ref": "#/$defs/digest"
    },
    "derived_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation_digest": {
      "$ref": "#/$defs/digest"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "candidates": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "ocr_digest": {
      "$ref": "#/$defs/digest"
    },
    "revision_digest": {
      "$ref": "#/$defs/digest"
    },
    "rule_config_digest": {
      "$ref": "#/$defs/digest"
    },
    "rule_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "generation_mode": {
      "enum": [
        "existing_outline",
        "toc_aligned",
        "safe_refusal"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "space_id",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "space_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "source_title",
        "effective_title",
        "source_level",
        "effective_level",
        "source_parent_id",
        "effective_parent_id",
        "target_page_id",
        "physical_page_index",
        "master_bbox",
        "outline_evidence",
        "evidence",
        "confidence",
        "status",
        "generator",
        "reason_codes",
        "rule_trace"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "effective_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_level": {
          "type": "integer",
          "minimum": 0
        },
        "effective_level": {
          "type": "integer",
          "minimum": 0
        },
        "source_parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_page_id": {
          "type": "string",
          "minLength": 1
        },
        "physical_page_index": {
          "type": "integer",
          "minimum": 0
        },
        "master_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/bbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "outline_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/outline"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "proposed",
            "needs_review",
            "confirmed",
            "rejected",
            "auto_confirmed",
            "skipped"
          ]
        },
        "generator": {
          "$ref": "#/$defs/generator"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence_breakdown": {
          "$ref": "#/$defs/breakdown"
        },
        "alignment_evidence": {
          "$ref": "#/$defs/alignment"
        },
        "automatic_decision": {
          "$ref": "#/$defs/automatic_decision"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "auto_confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "confidence_breakdown",
              "automatic_decision"
            ]
          }
        }
      ]
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "level",
        "target_page_id",
        "source"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "target_page_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/mdp_outline_ev"
        },
        {
          "$ref": "#/$defs/mdp_label_ev"
        },
        {
          "$ref": "#/$defs/mdp_typography_ev"
        },
        {
          "$ref": "#/$defs/mdp_region_ev"
        },
        {
          "$ref": "#/$defs/derived_page_ev"
        },
        {
          "$ref": "#/$defs/derived_line_ev"
        },
        {
          "$ref": "#/$defs/derived_word_ev"
        }
      ]
    },
    "mdp_outline_ev": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page_id",
        "ordinal",
        "source"
      ],
      "properties": {
        "kind": {
          "const": "mdp_outline"
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mdp_label_ev": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page_id",
        "label"
      ],
      "properties": {
        "kind": {
          "const": "mdp_page_label"
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mdp_typography_ev": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page_id",
        "ordinal",
        "bbox"
      ],
      "properties": {
        "kind": {
          "const": "mdp_typography"
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "bbox": {
          "$ref": "#/$defs/rect"
        }
      }
    },
    "mdp_region_ev": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page_id",
        "ordinal",
        "bbox"
      ],
      "properties": {
        "kind": {
          "const": "mdp_region"
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "bbox": {
          "$ref": "#/$defs/rect"
        }
      }
    },
    "derived_page_ev": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page_id",
        "bbox"
      ],
      "properties": {
        "kind": {
          "const": "derived_page"
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "derived_line_ev": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page_id",
        "line_id",
        "bbox"
      ],
      "properties": {
        "kind": {
          "const": "derived_line"
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "line_id": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "derived_word_ev": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page_id",
        "word_id",
        "bbox"
      ],
      "properties": {
        "kind": {
          "const": "derived_word"
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "word_id": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_match",
        "page_mapping",
        "numbering_hierarchy",
        "body_layout",
        "ocr_quality",
        "sequence_uniqueness",
        "total"
      ],
      "properties": {
        "title_match": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "page_mapping": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "numbering_hierarchy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "body_layout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "ocr_quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "sequence_uniqueness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toc_page_id",
        "toc_page_index",
        "toc_line_ids",
        "toc_word_ids",
        "body_page_id",
        "body_page_index",
        "body_line_id",
        "printed_label_raw",
        "printed_number",
        "numbering_family",
        "mapping_segment_index",
        "mapping_offset",
        "page_residual",
        "runner_up_margin",
        "column_index",
        "merged_toc_lines",
        "toc_has_leader",
        "body_human_revised",
        "secondary_key_only",
        "geometry_quality",
        "min_toc_word_confidence",
        "min_body_word_confidence"
      ],
      "properties": {
        "toc_page_id": {
          "type": "string",
          "minLength": 1
        },
        "toc_page_index": {
          "type": "integer",
          "minimum": 0
        },
        "toc_line_ids": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "toc_word_ids": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "body_page_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_page_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "body_line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "printed_label_raw": {
          "anyOf": [
            {
              "type": "string",
              "maxItems": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "printed_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "numbering_family": {
          "anyOf": [
            {
              "enum": [
                "arabic",
                "roman"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "mapping_segment_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "mapping_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_residual": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "runner_up_margin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "column_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "merged_toc_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "toc_has_leader": {
          "type": "boolean"
        },
        "body_human_revised": {
          "type": "boolean"
        },
        "secondary_key_only": {
          "type": "boolean"
        },
        "geometry_quality": {
          "enum": [
            "measured",
            "approximate",
            "unknown"
          ]
        },
        "min_toc_word_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_body_word_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "automatic_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decided_status",
        "reason",
        "rule_version",
        "rule_config_digest"
      ],
      "properties": {
        "decided_status": {
          "enum": [
            "auto_confirmed",
            "needs_review",
            "skipped"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        },
        "rule_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "rule_config_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}