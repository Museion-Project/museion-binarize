    "operation":{"type":"object","additionalProperties":false,"required":["operation_id","candidate_id","operation"],"properties":{"operation_id":{"type":"string","minLength":1},"candidate_id":{"type":"string","minLength":1},"operation":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"const":"confirm"}}},{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"const":"reject"}}},{"type":"object","additionalProperties":false,"required":["kind","title"],"properties":{"kind":{"const":"edit"},"title":{"type":"string","minLength":1}}},{"type":"object","additionalProperties":false,"required":["kind","parent_id","level"],"properties":{"kind":{"const":"reparent"},"parent_id":{"type":["string","null"]},"level":{"type":"integer","minimum":0,"maximum":64}}}]}}}
