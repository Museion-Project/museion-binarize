{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mpdf.example/schema/bookmarks/0.1",
  "title":"Evidence-backed MPDF bookmarks 0.1",
  "type":"object","additionalProperties":false,
  "required":["schema","schema_version","source_digest","package_digest","derived_digest","generator","candidates","generation_digest"],
  "properties":{
    "schema":{"const":"mpdf-bookmarks"},"schema_version":{"const":"0.1"},
    "source_digest":{"$ref":"#/$defs/digest"},"package_digest":{"$ref":"#/$defs/digest"},"derived_digest":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"generation_digest":{"$ref":"#/$defs/digest"},"generator":{"$ref":"#/$defs/generator"},"candidates":{"type":"array","maxItems":100000,"items":{"$ref":"#/$defs/candidate"}}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"generator":{"type":"object","additionalProperties":false,"required":["kind","name","version"],"properties":{"kind":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}},
    "bbox":{"type":"object","additionalProperties":false,"required":["x","y","width","height"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number","minimum":0},"height":{"type":"number","minimum":0}}},
    "rect":{"type":"object","additionalProperties":false,"required":["space_id","x","y","width","height"],"properties":{"space_id":{"type":"string","minLength":1,"maxLength":512},"x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number","minimum":0},"height":{"type":"number","minimum":0}}},
    "candidate":{"type":"object","additionalProperties":false,"required":["candidate_id","source_title","effective_title","source_level","effective_level","source_parent_id","effective_parent_id","target_page_id","physical_page_index","master_bbox","outline_evidence","evidence","confidence","status","generator","reason_codes","rule_trace"],"properties":{"candidate_id":{"type":"string","minLength":1},"source_title":{"type":"string","minLength":1},"effective_title":{"type":"string","minLength":1},"source_level":{"type":"integer","minimum":0},"effective_level":{"type":"integer","minimum":0},"source_parent_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"effective_parent_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"target_page_id":{"type":"string","minLength":1},"physical_page_index":{"type":"integer","minimum":0},"master_bbox":{"anyOf":[{"$ref":"#/$defs/bbox"},{"type":"null"}]},"outline_evidence":{"anyOf":[{"$ref":"#/$defs/outline"},{"type":"null"}]},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},"confidence":{"type":"number","minimum":0,"maximum":1},"status":{"enum":["proposed","needs_review","confirmed","rejected"]},"generator":{"$ref":"#/$defs/generator"},"reason_codes":{"type":"array","items":{"type":"string"}},"rule_trace":{"type":"array","items":{"type":"string"}}}},
    "outline":{"type":"object","additionalProperties":false,"required":["title","level","target_page_id","source"],"properties":{"title":{"type":"string"},"level":{"type":"integer","minimum":0},"target_page_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"source":{"type":"string"}}},
    "evidence":{"oneOf":[{"$ref":"#/$defs/mdp_outline_ev"},{"$ref":"#/$defs/mdp_label_ev"},{"$ref":"#/$defs/mdp_typography_ev"},{"$ref":"#/$defs/mdp_region_ev"},{"$ref":"#/$defs/derived_page_ev"},{"$ref":"#/$defs/derived_line_ev"},{"$ref":"#/$defs/derived_word_ev"}]},
    "mdp_outline_ev":{"type":"object","additionalProperties":false,"required":["kind","page_id","ordinal","source"],"properties":{"kind":{"const":"mdp_outline"},"page_id":{"type":"string","minLength":1},"ordinal":{"type":"integer","minimum":0},"source":{"type":"string","minLength":1}}},
    "mdp_label_ev":{"type":"object","additionalProperties":false,"required":["kind","page_id","label"],"properties":{"kind":{"const":"mdp_page_label"},"page_id":{"type":"string","minLength":1},"label":{"type":"string","minLength":1}}},
    "mdp_typography_ev":{"type":"object","additionalProperties":false,"required":["kind","page_id","ordinal","bbox"],"properties":{"kind":{"const":"mdp_typography"},"page_id":{"type":"string","minLength":1},"ordinal":{"type":"integer","minimum":0},"bbox":{"$ref":"#/$defs/rect"}}},
    "mdp_region_ev":{"type":"object","additionalProperties":false,"required":["kind","page_id","ordinal","bbox"],"properties":{"kind":{"const":"mdp_region"},"page_id":{"type":"string","minLength":1},"ordinal":{"type":"integer","minimum":0},"bbox":{"$ref":"#/$defs/rect"}}},
    "derived_page_ev":{"type":"object","additionalProperties":false,"required":["kind","page_id","bbox"],"properties":{"kind":{"const":"derived_page"},"page_id":{"type":"string","minLength":1},"bbox":{"$ref":"#/$defs/bbox"}}},
    "derived_line_ev":{"type":"object","additionalProperties":false,"required":["kind","page_id","line_id","bbox"],"properties":{"kind":{"const":"derived_line"},"page_id":{"type":"string","minLength":1},"line_id":{"type":"string","minLength":1},"bbox":{"$ref":"#/$defs/bbox"}}},
    "derived_word_ev":{"type":"object","additionalProperties":false,"required":["kind","page_id","word_id","bbox"],"properties":{"kind":{"const":"derived_word"},"page_id":{"type":"string","minLength":1},"word_id":{"type":"string","minLength":1},"bbox":{"$ref":"#/$defs/bbox"}}}
  }
}
